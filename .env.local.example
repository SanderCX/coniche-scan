# Kopieer naar .env.local (die staat in .gitignore) en vul in.
# Zie scripts/gmail-refresh-token.mjs om GOOGLE_REFRESH_TOKEN op te halen.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_AFZENDER=jouw.gmail.adres@gmail.com

# Lokale, host-brede opslag (app/api/store/[key]/route.ts, lib/neon.ts):
# de Neon-connectiestring, uit het Neon-dashboard ("Connection string").
# Ontbreekt deze, dan valt de app terug op "nog nooit opgeslagen"-gedrag
# i.p.v. te crashen — niet verplicht om lokaal te ontwikkelen.
DATABASE_URL=
